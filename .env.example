# Security
SECRET_KEY=dev-secret-key-change-this-in-production-resume-screener-2026

# Database
# Default is SQLite file in backend/resume_screener.db
# For PostgreSQL: postgresql://username:password@localhost:5432/resume_screener_db
DATABASE_URL=sqlite:///resume_screener.db

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes

# NLTK Data directory (optional custom path)
# NLTK_DATA=
